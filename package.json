{
  "name": "ui-components",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4210",
    "build": "ng build",
    "watch": "ng build ui-components-lib --watch --configuration development",
    "test": "ng test",
    "storybook": "npx compodoc -p projects/ui-components-lib/tsconfig.lib.json -e json -d . && ng run ui-components-lib:storybook"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.2.4",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/localize": "^21.2.8",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@popperjs/core": "^2.11.8",
    "@primeuix/themes": "^1.2.3",
    "luxon": "^3.7.2",
    "moment-hijri": "^3.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2002.0",
    "@angular-devkit/build-angular": "^20.2.0",
    "@angular-devkit/core": "^20.2.0",
    "@angular/build": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.0",
    "@angular/platform-browser-dynamic": "^20.2.0",
    "@compodoc/compodoc": "^1.2.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/angular": "^10.3.5",
    "@types/jasmine": "~5.1.0",
    "@types/luxon": "^3.7.1",
    "@types/moment-hijri": "^2.1.4",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.2.0",
    "storybook": "^10.3.5",
    "typescript": "~5.9.2"
  }
}
